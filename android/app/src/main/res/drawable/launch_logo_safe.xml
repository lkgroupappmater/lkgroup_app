<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ masks the icon to the central 2/3 circle. Keep the complete
     148 x 116 logo inside the 192 dp circle on a 288 dp canvas at every density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="148dp" android:height="116dp" android:gravity="center">
        <bitmap android:src="@drawable/launch_logo" android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
